# Configuration template for Qoyod Accounting ERP
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qoyod
JWT_SECRET=change_this_to_a_secure_random_key_min_32_chars
ADMIN_EMAIL=admin@qoyod.local
ADMIN_PASSWORD=Admin123456!
CORS_ORIGINS=*
NODE_ENV=development

# ZATCA FATOORA integration (keep real values only in deployment secret settings)
# Start with sandbox. Never commit private keys or CSIDs.
ZATCA_ENVIRONMENT=sandbox
ZATCA_COMPLIANCE_CSID=
ZATCA_PRODUCTION_CSID=
ZATCA_PRIVATE_KEY_PATH=
ZATCA_CERTIFICATE_PATH=
